 {
  "id": "commit",
  "title": "execute() then commit()",
  "section": "connecttodatabase / InsertIntoDatabase",
  "blurb": "execute() only queues the change inside a transaction. Only commit() writes it to learn.db for everyone.",
  "code": [
   "import sqlite3",
   "conn = sqlite3.connect(\"learn.db\")",
   "cursor = conn.cursor()",
   "cursor.execute(\"INSERT INTO department VALUES (10, 'CSE')\")",
   "cursor.execute(\"INSERT INTO department VALUES (20, 'ECE')\")",
   "conn.commit()",
   "cursor.close()",
   "conn.close()"
  ],
