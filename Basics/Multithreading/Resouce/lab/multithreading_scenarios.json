 {
  "id": "condition",
  "title": "Condition: producer and consumer take turns",
  "section": "synchronousUsingCondition.py",
  "kind": "cond",
  "n": 1,
  "log": "cond",
  "blurb": "Producer calls put(), consumer calls get(). wait() pauses a thread, notify() wakes a thread that is already waiting.",
  "code": [
   "def put(self, data):          # producer thread",
   "    self.cv.acquire()",
   "    self.cv.wait(timeout=0)",
   "    self.data = data",
   "    print(f'produced {self.data}')",
   "    self.cv.notify()",
   "    self.cv.release()",
   "    sleep(1)",
   "def get(self):                # consumer thread",
   "    self.cv.acquire()",
   "    self.cv.wait()",
   "    x = self.data",
   "    print(f'Consumed {x}')",
   "    self.cv.notify()",
   "    self.cv.release()",
   "    sleep(1)"
  ],
  "names": {
   "T1": "T1  producer: put()",
   "T2": "T2  consumer: get()"
  },
