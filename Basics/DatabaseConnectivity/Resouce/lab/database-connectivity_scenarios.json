 {
  "id": "fetch",
  "title": "fetchone / fetchmany / fetchall",
  "section": "select.py",
  "blurb": "Rows are consumed as you fetch them: each fetch continues where the last one stopped.",
  "code": [
   "import sqlite3",
   "conn = sqlite3.connect(\"learn.db\")",
   "cursor = conn.cursor()",
   "rows = cursor.execute(\"SELECT * FROM department\")",
   "print(rows.fetchone())",
   "print(rows.fetchmany(2))",
   "print(rows.fetchall())",
   "print(rows.fetchone())"
  ],
