 {
  "id": "update",
  "title": "UPDATE, DELETE, rowcount, rollback",
  "section": "DMLupdateQuery.pdf",
  "blurb": "The ? placeholders pass values safely. rowcount tells you how many rows a statement changed. rollback() throws away uncommitted work.",
  "code": [
   "import sqlite3",
   "conn = sqlite3.connect(\"univ.db\")",
   "cur = conn.cursor()",
   "cur.execute(\"UPDATE department SET name = ? WHERE name = ?\", (\"Chem\", \"Mech.\"))",
   "print(cur.rowcount)",
   "cur.execute(\"DELETE FROM department WHERE deptNo = ?\", (40,))",
   "print(cur.rowcount)",
   "cur.execute(\"INSERT INTO department VALUES (?, ?)\", (10, \"Again\"))",
   "conn.rollback()",
